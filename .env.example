# ============================================================
# BookRecommendation 环境变量示例（配置外置）
# 复制为 .env 后按需修改；Spring Boot 不会自动读取 .env 文件，
# 需配合以下任一方式使用：
#   - PowerShell：启动前手动设置，如
#       $env:SPRING_DATASOURCE_DRUID_PASSWORD='your-pass'
#     （脚本 scripts\start-book.ps1 已内置本机默认值，一般无需设置）
#   - Docker Compose：docker compose --env-file .env up -d
#   - 云端平台（Render 等）：在控制台 Environment 中逐项填写
# 未设置时，代码内置默认值（本机 localhost:3306 root/root、localhost:9092）生效。
# ============================================================

# ---- 后端：数据库连接（Druid 前缀，见 application-dev.yml）----
# 本地默认：jdbc:mysql://localhost:3306/library?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&useSSL=true&nullCatalogMeansCurrent=true
SPRING_DATASOURCE_DRUID_URL=
SPRING_DATASOURCE_DRUID_USERNAME=root
SPRING_DATASOURCE_DRUID_PASSWORD=root

# 连接池（TiDB Serverless 等低并发库请调小，如 2/2/10）
SPRING_DATASOURCE_DRUID_INITIAL_SIZE=10
SPRING_DATASOURCE_DRUID_MIN_IDLE=10
SPRING_DATASOURCE_DRUID_MAX_ACTIVE=100

# ---- 后端：Kafka 地址（不设置时默认 localhost:9092；无 broker 时后端仍可启动，进入预置推荐模式）----
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- 前端：API 基址（frontend/.env.production 已指向 Render 后端；本地开发默认 http://localhost:8081/book_recommendation）----
VUE_APP_API_BASE_URL=http://localhost:8081/book_recommendation

# ---- 大数据模块（bigdata）----
# Step8 / NewBookRecommend / RelatedBookRecommend 的 JDBC 回写地址经 com.hytc.util.JdbcConfig 读取，
# 优先级：环境变量 > config.properties 的 db.* > 本机默认值（jdbc:mysql://localhost:3306/library root/root）。
# Docker 全链路由 docker-compose 的 bigdata 服务注入 BOOK_DB_URL=jdbc:mysql://mysql:3306/library。
BOOK_DB_URL=jdbc:mysql://localhost:3306/library
BOOK_DB_USER=root
BOOK_DB_PASSWORD=root
# Kafka 消费地址经 KafkaUtil 读取，优先级：环境变量 > config.properties 的 kafka.broker > 默认值。
# Docker 全链路由 compose 注入 BOOK_KAFKA_BROKER=kafka:9092。
BOOK_KAFKA_BROKER=localhost:9092
